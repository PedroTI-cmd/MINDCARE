# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" nunca deve ser versionado (está no .gitignore).
#
# Para gerar uma SECRET_KEY segura, execute:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Obrigatórios em produção ─────────────────────────────────────────────────
SECRET_KEY=substitua-por-uma-chave-secreta-forte-aqui
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mindcare

# ── Ambiente Flask ────────────────────────────────────────────────────────────
# Opções: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi.py

# ── Segurança de sessão ───────────────────────────────────────────────────────
# true em produção (exige HTTPS), false em desenvolvimento local
SESSION_COOKIE_SECURE=false

# ── Política de login ─────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=8

# ── Agendamento ───────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_DAY=2
PATIENTS_PER_PAGE=20

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Em produção use Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
